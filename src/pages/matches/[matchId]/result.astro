---
import Base from '../../../layouts/Base.astro'
import { ResultWithToaster } from '../../../components/result/ResultWithToaster'
import { getDb } from '../../../lib/db'
import { matches, matchSetStrategyReviews, matchSets, points, players, strategySnapshots, teamMembers, teams } from '../../../schema'
import { eq, and } from 'drizzle-orm'
import { computeStats, computeTimelineWithSets } from '../../../lib/utils/stats'
import type { Player, MatchSet, Point } from '../../../types'

const user = Astro.locals.user!
import { env } from 'cloudflare:workers'
const db = getDb(env.DB)
const { matchId } = Astro.params as { matchId: string }

const match = await db.select().from(matches).where(eq(matches.id, matchId)).get()
if (!match) return Astro.redirect('/dashboard')

const membership = await db.select().from(teamMembers)
  .where(and(eq(teamMembers.teamId, match.teamId), eq(teamMembers.userId, user.id))).get()
if (!membership) return Astro.redirect('/dashboard')

const team = await db.select().from(teams).where(eq(teams.id, match.teamId)).get()
const dbSets = await db.select().from(matchSets).where(eq(matchSets.matchId, matchId))
const dbPoints = await db.select().from(points).where(eq(points.matchId, matchId))
const dbPlayers = await db.select().from(players).where(eq(players.teamId, match.teamId))
const strategySnapshotRows = await db.select().from(strategySnapshots).where(eq(strategySnapshots.matchId, matchId))
const strategyReviewRows = await db.select().from(matchSetStrategyReviews).where(eq(matchSetStrategyReviews.matchId, matchId))
const reviewBySet = new Map(strategyReviewRows.map((review) => [review.setNumber, review]))

// Map to snake_case for React components and utils
const setsForClient: MatchSet[] = dbSets.map((s) => ({
  id: s.id,
  match_id: s.matchId,
  set_number: s.setNumber,
  home_score: s.homeScore,
  away_score: s.awayScore,
  winner: s.winner as MatchSet['winner'],
  completed: s.completed,
  created_at: s.createdAt,
}))

const pointsForUtils: Point[] = dbPoints.map((p) => ({
  id: p.id,
  match_id: p.matchId,
  set_id: p.setId,
  point_number: p.pointNumber,
  scorer: p.scorer as Point['scorer'],
  home_score: p.homeScore,
  away_score: p.awayScore,
  rotation_index: p.rotationIndex,
  action_type: p.actionType as Point['action_type'],
  player_id: p.playerId,
  is_detail_logged: p.isDetailLogged,
  created_at: p.createdAt,
}))

const playersForClient: Player[] = dbPlayers.map((p) => ({
  id: p.id,
  team_id: p.teamId,
  name: p.name,
  number: p.number,
  position: p.position as Player['position'],
  is_libero: p.isLibero,
  created_at: p.createdAt,
}))

const stats = computeStats(pointsForUtils, playersForClient, match.detailLogStartPoint)
stats.scoreTimeline = computeTimelineWithSets(
  pointsForUtils,
  dbSets.map((s) => ({ id: s.id, set_number: s.setNumber, home_score: s.homeScore, away_score: s.awayScore, completed: s.completed }))
)
---
<Base title="試合結果">
  <div class="min-h-screen bg-slate-50">
    <header class="app-header px-2 py-2 sticky top-0 z-10">
      <div class="max-w-2xl mx-auto flex items-center justify-between">
        <div class="flex items-center gap-2">
          <a href="/dashboard" class="flex items-center gap-1 min-h-[44px] min-w-[44px] px-3 text-slate-300 hover:text-white text-sm font-medium transition-colors rounded-lg hover:bg-white/10">← 戻る</a>
          <div>
            <div class="text-sm font-semibold text-white">{team?.name} <span class="text-slate-400">vs</span> {match.opponentName}</div>
            <div class="text-xs text-slate-400">{match.matchDate}</div>
          </div>
        </div>
        {match.status === 'in_progress' && (
          <a href={`/matches/${matchId}/record`} class="btn-secondary text-xs px-3 py-1.5">記録に戻る</a>
        )}
      </div>
    </header>

    <main class="max-w-2xl mx-auto p-4">
      {strategySnapshotRows.length > 0 && (
        <section class="card p-4 mb-4">
          <h2 class="text-base font-semibold text-slate-900">作戦ボード振り返り</h2>
          <p class="mt-1 text-xs text-slate-500">作戦内容と結果の因果関係は自動判定しません。実行メモとして残します。</p>
          <div class="mt-3 space-y-3">
            {strategySnapshotRows.map((snapshot) => {
              const review = reviewBySet.get(snapshot.setNumber ?? 0)
              const parsedReview = review ? JSON.parse(review.postMatchReview) : {}
              return (
                <div class="rounded-lg border p-3">
                  <div class="flex items-center justify-between gap-2">
                    <div class="text-sm font-bold text-slate-800">第{snapshot.setNumber ?? '-'}セット</div>
                    <div class="text-[11px] text-slate-500">snapshot: {snapshot.id.slice(0, 8)}</div>
                  </div>
                  <div class="mt-2 grid gap-2">
                    <textarea class="field-input review-worked min-h-16" data-set={snapshot.setNumber} data-snapshot={snapshot.id} data-plan={snapshot.strategyPlanId} placeholder="うまくいったこと">{parsedReview.workedWell ?? ''}</textarea>
                    <textarea class="field-input review-didnot min-h-16" data-set={snapshot.setNumber} data-snapshot={snapshot.id} data-plan={snapshot.strategyPlanId} placeholder="うまくいかなかったこと">{parsedReview.didNotWork ?? ''}</textarea>
                    <textarea class="field-input review-execution min-h-16" data-set={snapshot.setNumber} data-snapshot={snapshot.id} data-plan={snapshot.strategyPlanId} placeholder="実行メモ">{parsedReview.executionNotes ?? ''}</textarea>
                    <textarea class="field-input review-next min-h-16" data-set={snapshot.setNumber} data-snapshot={snapshot.id} data-plan={snapshot.strategyPlanId} placeholder="次回調整">{parsedReview.nextAdjustments ?? ''}</textarea>
                    <textarea class="field-input review-opponent min-h-16" data-set={snapshot.setNumber} data-snapshot={snapshot.id} data-plan={snapshot.strategyPlanId} placeholder="実際の相手傾向">{parsedReview.opponentActualTendencies ?? ''}</textarea>
                    <button type="button" class="save-strategy-review btn-secondary text-xs py-2" data-set={snapshot.setNumber} data-snapshot={snapshot.id} data-plan={snapshot.strategyPlanId}>振り返りを保存</button>
                  </div>
                </div>
              )
            })}
          </div>
        </section>
      )}
      <ResultWithToaster
        client:load
        teamName={team?.name ?? '自チーム'}
        opponentName={match.opponentName}
        matchDate={match.matchDate}
        location={match.location}
        sets={setsForClient}
        stats={stats}
        shareUuid={match.shareUuid}
        showSharePanel={true}
      />
    </main>
  </div>
</Base>

<script define:vars={{ matchId }}>
  function valueFor(selector) {
    return document.querySelector(selector)?.value ?? ''
  }

  document.querySelectorAll('.save-strategy-review').forEach((button) => {
    button.addEventListener('click', async () => {
      const setNumber = Number(button.dataset.set)
      const strategySnapshotId = button.dataset.snapshot
      const strategyPlanId = button.dataset.plan
      const res = await fetch(`/api/matches/${matchId}/strategy-reviews`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          setNumber,
          strategySnapshotId,
          strategyPlanId,
          postMatchReview: {
            workedWell: valueFor(`.review-worked[data-set="${setNumber}"]`),
            didNotWork: valueFor(`.review-didnot[data-set="${setNumber}"]`),
            executionNotes: valueFor(`.review-execution[data-set="${setNumber}"]`),
            nextAdjustments: valueFor(`.review-next[data-set="${setNumber}"]`),
            opponentActualTendencies: valueFor(`.review-opponent[data-set="${setNumber}"]`),
          },
          rotationReviews: [],
        }),
      })
      if (res.ok) alert('作戦振り返りを保存しました。')
      else {
        const json = await res.json()
        alert(json.error ?? '作戦振り返りを保存できませんでした。')
      }
    })
  })
</script>
