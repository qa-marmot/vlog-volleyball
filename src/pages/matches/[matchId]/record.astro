---
import Base from '../../../layouts/Base.astro'
import { MatchRecorder } from '../../../components/match/MatchRecorder'
import { getDb } from '../../../lib/db'
import { matches, teamMembers, players, teams, strategyPlans, strategySnapshots } from '../../../schema'
import { eq, and, isNull } from 'drizzle-orm'
import type { Player } from '../../../types'

const user = Astro.locals.user!
import { env } from 'cloudflare:workers'
const db = getDb(env.DB)
const { matchId } = Astro.params as { matchId: string }

const match = await db.select().from(matches).where(eq(matches.id, matchId)).get()
if (!match) return Astro.redirect('/dashboard')

const membership = await db.select().from(teamMembers)
  .where(and(eq(teamMembers.teamId, match.teamId), eq(teamMembers.userId, user.id))).get()
if (!membership) return Astro.redirect('/dashboard')

if (match.status === 'completed') return Astro.redirect(`/matches/${matchId}/result`)

const team = await db.select().from(teams).where(eq(teams.id, match.teamId)).get()
const teamPlayers = await db.select().from(players).where(eq(players.teamId, match.teamId))
const finalizedStrategyPlans = await db.select().from(strategyPlans)
  .where(and(eq(strategyPlans.teamId, match.teamId), eq(strategyPlans.status, 'finalized'), isNull(strategyPlans.deletedAt)))
const linkedStrategySnapshots = await db.select().from(strategySnapshots).where(eq(strategySnapshots.matchId, matchId))
const snapshotPlanNames = new Map(finalizedStrategyPlans.map((plan) => [plan.id, plan.name]))

// Map Drizzle camelCase to snake_case for React components
const playersForClient: Player[] = teamPlayers.map((p) => ({
  id: p.id,
  team_id: p.teamId,
  name: p.name,
  number: p.number,
  position: p.position as Player['position'],
  is_libero: p.isLibero,
  created_at: p.createdAt,
}))
---
<Base title="試合記録">
  <div class="min-h-screen bg-slate-50">
    <header class="app-header px-2 py-2 sticky top-0 z-10">
      <div class="max-w-lg mx-auto flex items-center justify-between">
        <div class="flex items-center gap-2">
          <a href="/dashboard" class="flex items-center gap-1 min-h-[44px] min-w-[44px] px-3 text-slate-300 hover:text-white text-sm font-medium transition-colors rounded-lg hover:bg-white/10">← 戻る</a>
          <div>
            <div class="text-sm font-semibold text-white">{team?.name} <span class="text-slate-400">vs</span> {match.opponentName}</div>
            <div class="text-xs text-slate-400">{match.matchDate}</div>
          </div>
        </div>
        <span class="badge-active">● 記録中</span>
      </div>
    </header>

    <main class="max-w-lg mx-auto p-4 space-y-4">
      <section class="card p-4">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h1 class="text-sm font-semibold text-slate-900">作戦プラン連携</h1>
            <p class="mt-1 text-xs text-slate-500">セット単位で作戦snapshotを保存します。保存後の振り返りは試合結果画面で入力できます。</p>
          </div>
          <a href={`/teams/${match.teamId}/strategy`} class="btn-secondary px-3 py-2 text-xs">作戦一覧</a>
        </div>

        {finalizedStrategyPlans.length === 0 ? (
          <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-800">
            finalized済みの作戦プランがありません。作戦一覧でプランをfinalizedにすると紐づけできます。
          </div>
        ) : (
          <div class="mt-3 grid gap-2 sm:grid-cols-[minmax(0,1fr)_86px]">
            <select id="strategy-plan-link" class="field-input text-xs">
              {finalizedStrategyPlans.map((plan) => (
                <option value={plan.id} selected={plan.setNumber === 1}>{plan.name}{plan.setNumber ? ` / 第${plan.setNumber}セット` : ''}{plan.opponentName ? ` / vs ${plan.opponentName}` : ''}</option>
              ))}
            </select>
            <select id="strategy-set-link" class="field-input text-xs">
              {[1, 2, 3, 4, 5].map((setNumber) => <option value={setNumber}>第{setNumber}</option>)}
            </select>
            <button id="link-strategy-snapshot" type="button" class="btn-primary py-2 text-xs sm:col-span-2">この試合に作戦snapshotを保存</button>
          </div>
        )}

        <div id="strategy-link-message" class="mt-3 hidden rounded-lg border border-blue-100 bg-blue-50 p-2 text-xs text-blue-800"></div>

        {linkedStrategySnapshots.length > 0 && (
          <div class="mt-3 space-y-2">
            {linkedStrategySnapshots.map((snapshot) => (
              <div class="flex items-center justify-between gap-2 rounded-lg border bg-slate-50 px-3 py-2 text-xs">
                <div>
                  <span class="font-semibold">第{snapshot.setNumber ?? '-'}セット</span>
                  <span class="ml-2 text-slate-500">{snapshotPlanNames.get(snapshot.strategyPlanId) ?? '作戦プラン'}</span>
                </div>
                <span class="text-slate-400">snapshot {snapshot.id.slice(0, 8)}</span>
              </div>
            ))}
          </div>
        )}
      </section>

      <MatchRecorder
        client:load
        matchId={matchId}
        teamId={match.teamId}
        teamName={team?.name ?? '自チーム'}
        opponentName={match.opponentName}
        matchDate={match.matchDate}
        shareUuid={match.shareUuid}
        players={playersForClient}
      />
    </main>
  </div>
</Base>

<script define:vars={{ teamId: match.teamId, matchId }}>
  const message = document.getElementById('strategy-link-message')

  function showStrategyMessage(text, isError = false) {
    if (!message) return
    message.classList.remove('hidden', 'border-blue-100', 'bg-blue-50', 'text-blue-800', 'border-red-100', 'bg-red-50', 'text-red-800')
    message.classList.add(isError ? 'border-red-100' : 'border-blue-100', isError ? 'bg-red-50' : 'bg-blue-50', isError ? 'text-red-800' : 'text-blue-800')
    message.textContent = text
  }

  document.getElementById('link-strategy-snapshot')?.addEventListener('click', async () => {
    const planId = document.getElementById('strategy-plan-link')?.value
    const setNumber = Number(document.getElementById('strategy-set-link')?.value || 1)
    if (!planId) return

    const res = await fetch(`/api/teams/${teamId}/strategies/${planId}/snapshots`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ matchId, setNumber }),
    })
    const json = await res.json()
    if (res.ok) {
      showStrategyMessage(`第${setNumber}セットに作戦snapshotを保存しました。`)
      window.location.reload()
    } else {
      showStrategyMessage(json.error ?? '作戦snapshotを保存できませんでした。', true)
    }
  })
</script>
