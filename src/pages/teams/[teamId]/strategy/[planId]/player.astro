---
import Base from '../../../../../layouts/Base.astro'
import { env } from 'cloudflare:workers'
import { and, eq, isNull } from 'drizzle-orm'
import { getDb } from '../../../../../lib/db'
import { players, strategyPlans, teamMembers, teams } from '../../../../../schema'
import { StrategyPlanDataSchema, validateStrategyPlanData } from '../../../../../lib/strategy/schema'
import { projectStrategyForView } from '../../../../../lib/strategy/share'

const user = Astro.locals.user!
const { teamId, planId } = Astro.params as { teamId: string; planId: string }
const db = getDb(env.DB)

const membership = await db.select().from(teamMembers)
  .where(and(eq(teamMembers.teamId, teamId), eq(teamMembers.userId, user.id))).get()
if (!membership) return Astro.redirect('/dashboard')

const team = await db.select().from(teams).where(eq(teams.id, teamId)).get()
const plan = await db.select().from(strategyPlans)
  .where(and(eq(strategyPlans.id, planId), eq(strategyPlans.teamId, teamId), isNull(strategyPlans.deletedAt))).get()
if (!team || !plan) return Astro.redirect(`/teams/${teamId}/strategy`)

const data = StrategyPlanDataSchema.parse(JSON.parse(plan.data))
const validation = validateStrategyPlanData(data, plan.status as any)
const projected = projectStrategyForView({ data, scope: 'player', warnings: validation.warnings })
const teamPlayers = await db.select().from(players).where(eq(players.teamId, teamId))
const playerMap = new Map(teamPlayers.map((p) => [p.id, p]))

function playerLabel(id: string) {
  const p = playerMap.get(id)
  if (!p) return '未登録'
  return `#${p.number} ${p.position ?? ''}`
}
---
<Base title={`${plan.name} 選手表示`}>
  <div class="min-h-screen bg-slate-50">
    <header class="app-header px-2 py-2 sticky top-0 z-10">
      <div class="mx-auto flex max-w-4xl items-center justify-between">
        <div class="flex items-center gap-2">
          <a href={`/teams/${teamId}/strategy/${planId}`} class="flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg px-3 text-lg font-bold text-slate-300 hover:bg-white/10 hover:text-white">←</a>
          <div>
            <div class="text-sm font-semibold text-white">{plan.name}</div>
            <div class="text-xs text-slate-400">選手向け簡易表示</div>
          </div>
        </div>
        <span class="text-[11px] text-slate-300">{projected.setNumber ? `第${projected.setNumber}セット` : 'セット未設定'}</span>
      </div>
    </header>

    <main class="mx-auto max-w-4xl p-4 space-y-3">
      <section class="rounded-lg border bg-white p-3">
        <div class="text-xs font-semibold text-slate-500">{team.name}</div>
        <h1 class="mt-1 text-lg font-bold text-slate-900">{projected.name}</h1>
        <p class="mt-1 text-xs text-slate-500">相手分析詳細・コーチ専用メモ・変更履歴は表示しません。</p>
      </section>

      <section class="grid gap-3 sm:grid-cols-2">
        {projected.rotations.map((rotation) => (
          <article class="rounded-lg border bg-white p-3">
            <div class="flex items-center justify-between gap-2">
              <h2 class="text-base font-bold text-slate-900">{rotation.key}</h2>
              <span class="rounded-full bg-slate-100 px-2 py-1 text-[11px] font-semibold text-slate-600">{rotation.primaryFocusPhase}</span>
            </div>
            <div class="mt-2 grid grid-cols-3 gap-1 text-[11px]">
              {rotation.courtPlayerIds.map((id) => <div class="rounded border bg-slate-50 px-2 py-1 text-center font-semibold">{playerLabel(id)}</div>)}
            </div>
            <div class="mt-3 space-y-2 text-sm">
              <div class="rounded border-l-4 border-blue-500 bg-blue-50 p-2">
                <div class="text-[11px] font-bold text-blue-700">keyPoint</div>
                <div>{rotation.keyPoint || '未設定'}</div>
              </div>
              <div class="rounded border-l-4 border-orange-500 bg-orange-50 p-2">
                <div class="text-[11px] font-bold text-orange-700">avoidNote</div>
                <div>{rotation.avoidNote || '未設定'}</div>
              </div>
              <div class="grid grid-cols-3 gap-1 text-xs">
                <div class="rounded bg-slate-100 p-2"><b>A</b><br />{rotation.receiveFirstOptions.good}</div>
                <div class="rounded bg-slate-100 p-2"><b>B</b><br />{rotation.receiveFirstOptions.medium}</div>
                <div class="rounded bg-slate-100 p-2"><b>C</b><br />{rotation.receiveFirstOptions.bad}</div>
              </div>
              <div class="text-xs text-slate-600">{rotation.autoSummary}</div>
            </div>
          </article>
        ))}
      </section>

      {projected.warnings.length > 0 && (
        <section class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
          <div class="font-semibold">注意</div>
          <ul class="mt-1 list-disc pl-5">
            {projected.warnings.map((warning) => <li>{warning.message}</li>)}
          </ul>
        </section>
      )}
    </main>
  </div>
</Base>
