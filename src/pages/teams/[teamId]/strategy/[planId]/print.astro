---
import Base from '../../../../../layouts/Base.astro'
import { env } from 'cloudflare:workers'
import { and, eq, isNull } from 'drizzle-orm'
import { getDb } from '../../../../../lib/db'
import { players, strategyPlans, teamMembers, teams } from '../../../../../schema'
import { StrategyPlanDataSchema, validateStrategyPlanData } from '../../../../../lib/strategy/schema'
import { projectStrategyForView } from '../../../../../lib/strategy/share'

const user = Astro.locals.user!
const { teamId, planId } = Astro.params as { teamId: string; planId: string }
const db = getDb(env.DB)

const membership = await db.select().from(teamMembers)
  .where(and(eq(teamMembers.teamId, teamId), eq(teamMembers.userId, user.id))).get()
if (!membership) return Astro.redirect('/dashboard')

const team = await db.select().from(teams).where(eq(teams.id, teamId)).get()
const plan = await db.select().from(strategyPlans)
  .where(and(eq(strategyPlans.id, planId), eq(strategyPlans.teamId, teamId), isNull(strategyPlans.deletedAt))).get()
if (!team || !plan) return Astro.redirect(`/teams/${teamId}/strategy`)

const data = StrategyPlanDataSchema.parse(JSON.parse(plan.data))
const validation = validateStrategyPlanData(data, plan.status as any)
const projected = projectStrategyForView({ data, scope: 'print', warnings: validation.warnings })
const teamPlayers = await db.select().from(players).where(eq(players.teamId, teamId))
const playerMap = new Map(teamPlayers.map((p) => [p.id, p]))

function playerLabel(id: string) {
  const p = playerMap.get(id)
  if (!p) return '未登録'
  return `#${p.number} ${p.name}${p.position ? ` ${p.position}` : ''}`
}
---
<Base title={`${plan.name} 印刷`}>
  <main class="mx-auto max-w-6xl bg-white p-6 text-slate-900">
    <header class="flex items-start justify-between border-b pb-4 print:pb-2">
      <div>
        <div class="text-xs font-semibold text-slate-500">{team.name}</div>
        <h1 class="mt-1 text-2xl font-bold">{projected.name}</h1>
        <p class="mt-1 text-sm text-slate-600">
          {projected.opponentName ? `対戦相手: ${projected.opponentName}` : '対戦相手未設定'}
          {projected.setNumber ? ` / 第${projected.setNumber}セット` : ''}
          {' / '}
          サーブ想定は開始条件からの目安
        </p>
      </div>
      <button class="btn-secondary print:hidden" onclick="window.print()">印刷</button>
    </header>

    <section class="mt-4 grid gap-3 md:grid-cols-2">
      {projected.rotations.map((rotation) => (
        <article class="break-inside-avoid rounded-lg border p-3">
          <div class="flex items-center justify-between gap-2">
            <h2 class="text-lg font-bold">{rotation.key}</h2>
            <span class="text-xs text-slate-500">{rotation.primaryFocusPhase}</span>
          </div>
          <p class="mt-2 text-sm leading-6">{rotation.autoSummary}</p>
          <div class="mt-3 grid grid-cols-3 gap-1 text-[11px]">
            {rotation.courtPlayerIds.map((id) => <div class="rounded border px-2 py-1">{playerLabel(id)}</div>)}
          </div>
          <div class="mt-3 grid grid-cols-2 gap-2 text-xs">
            <div><span class="font-semibold">keyPoint:</span> {rotation.keyPoint || '未設定'}</div>
            <div><span class="font-semibold">avoidNote:</span> {rotation.avoidNote || '未設定'}</div>
            <div><span class="font-semibold">Aパス1st:</span> {rotation.receiveFirstOptions.good}</div>
            <div><span class="font-semibold">Bパス1st:</span> {rotation.receiveFirstOptions.medium}</div>
            <div><span class="font-semibold">Cパス1st:</span> {rotation.receiveFirstOptions.bad}</div>
            <div><span class="font-semibold">ブロック:</span> {rotation.blockPlan.blockSystem}{rotation.blockPlan.blockFocus ? ` / ${rotation.blockPlan.blockFocus}` : ''}</div>
          </div>
        </article>
      ))}
    </section>

    <section class="mt-4 rounded-lg border p-3 text-xs">
      <h2 class="font-bold">凡例</h2>
      <div class="mt-2 grid gap-1 sm:grid-cols-3">
        <div>攻撃線: 実線</div>
        <div>移動線: 点線</div>
        <div>サーブ線: 太線</div>
        <div>ブロック: 壁アイコン</div>
        <div>守備: ゾーン表示</div>
        <div>カバー: 薄い面</div>
      </div>
    </section>

    {projected.warnings.length > 0 && (
      <section class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
        <div class="font-semibold">注意</div>
        <ul class="mt-1 list-disc pl-5">
          {projected.warnings.map((warning) => <li>{warning.message}</li>)}
        </ul>
      </section>
    )}
  </main>
</Base>
