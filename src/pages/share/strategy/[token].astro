---
import bcrypt from 'bcryptjs'
import Base from '../../../layouts/Base.astro'
import { env } from 'cloudflare:workers'
import { and, eq, isNull } from 'drizzle-orm'
import { getDb } from '../../../lib/db'
import { players, strategyPlans, strategyShareLinks, teams } from '../../../schema'
import { StrategyPlanDataSchema, validateStrategyPlanData } from '../../../lib/strategy/schema'
import { generateShareSummaryText, projectStrategyForView } from '../../../lib/strategy/share'

const { token } = Astro.params as { token: string }
const db = getDb(env.DB)
const link = await db.select().from(strategyShareLinks).where(eq(strategyShareLinks.shareToken, token)).get()

let error = ''
let projected: ReturnType<typeof projectStrategyForView> | null = null
let plan: typeof strategyPlans.$inferSelect | null = null
let team: typeof teams.$inferSelect | null = null
let playerMap = new Map<string, typeof players.$inferSelect>()
let shareSummaryText = ''
const password = Astro.url.searchParams.get('password') ?? ''
const layoutSlots = [
  [3, 4, 5],
  [2, 1, 0],
]
const slotLabels = ['RB', 'CB', 'LB', 'LF', 'CF', 'RF']
const scopeLabels = {
  full: '全体共有',
  player: '選手向け',
  print: '印刷用',
  summary: '要約',
} as const
const focusLabels = {
  unknown: '未設定',
  receive: 'レシーブ時',
  serve: '自サーブ時',
  both: '両方',
} as const
const servingTeamLabels = {
  own: '自チーム',
  opponent: '相手',
  unknown: '未定',
} as const
const serveTargetLabels: Record<string, string> = {
  short: '短め',
  deep: '深め',
  seam: '選手間',
  player_zone: '選手・ゾーン',
  avoid_libero: 'リベロ回避',
  front_back_gap: '前後差',
  setter_front: 'セッター前',
  approach_disrupt: '助走を潰す',
  sideline: 'サイドライン際',
  endline: 'エンドライン際',
  safe_in: '安全に入れる',
}
const blockSystemLabels: Record<string, string> = {
  read: 'リード',
  commit: 'コミット',
  bunch: 'バンチ',
  spread: 'スプレッド',
}
const blockFocusLabels: Record<string, string> = {
  cross: 'クロス',
  line: 'ライン',
  middle: 'ミドル',
  pipe: 'パイプ',
  setter_dump: 'セッターダンプ',
}
const opponentSetterStateLabels: Record<string, string> = {
  unknown: '未設定',
  front: '前衛',
  back: '後衛',
  mixed: '混在',
}

if (!link || !link.enabled || link.revokedAt || (link.expiresAt && new Date(link.expiresAt).getTime() <= Date.now())) {
  error = '共有リンクは無効です。'
} else if (link.passwordProtected && (!password || !link.passwordHash || !(await bcrypt.compare(password, link.passwordHash)))) {
  error = 'パスワードを入力してください。'
} else {
  plan = await db.select().from(strategyPlans)
    .where(and(eq(strategyPlans.id, link.strategyPlanId), eq(strategyPlans.teamId, link.teamId), isNull(strategyPlans.deletedAt))).get() ?? null
  team = await db.select().from(teams).where(eq(teams.id, link.teamId)).get() ?? null
  if (!plan || !team || plan.status !== 'finalized') {
    error = '共有できる作戦プランが見つかりません。'
  } else {
    const data = StrategyPlanDataSchema.parse(JSON.parse(plan.data))
    const validation = validateStrategyPlanData(data, plan.status as any)
    projected = projectStrategyForView({
      data,
      scope: link.viewScope as any,
      warnings: validation.warnings,
      includeOpponentScout: link.includeOpponentScout,
    })
    const teamPlayers = await db.select().from(players).where(eq(players.teamId, link.teamId))
    playerMap = new Map(teamPlayers.map((p) => [p.id, p]))
    shareSummaryText = generateShareSummaryText(data, Astro.url.toString())
  }
}

function playerLabel(id: string) {
  const p = playerMap.get(id)
  if (!p) return '未登録'
  return `#${p.number} ${p.name}${p.position ? ` ${p.position}` : ''}`
}

function shortPlayerLabel(id: string) {
  const p = playerMap.get(id)
  if (!p) return '未登録'
  return `#${p.number} ${p.name}`
}

function focusLabel(value: string) {
  return focusLabels[value as keyof typeof focusLabels] ?? value
}

function scopeLabel(value: string) {
  return scopeLabels[value as keyof typeof scopeLabels] ?? value
}

function servingTeamLabel(value: string) {
  return servingTeamLabels[value as keyof typeof servingTeamLabels] ?? value
}

function serveTargetText(rotation: NonNullable<typeof projected>['rotations'][number]) {
  const target = rotation.serveTarget
  const base = serveTargetLabels[target.targetType] ?? target.targetType
  const detail = target.playerLabel || target.zone
  return detail ? `${base} / ${detail}` : base
}

function blockPlanText(rotation: NonNullable<typeof projected>['rotations'][number]) {
  const block = rotation.blockPlan
  const system = blockSystemLabels[block.blockSystem] ?? block.blockSystem
  const focus = block.blockFocus ? (blockFocusLabels[block.blockFocus] ?? block.blockFocus) : ''
  return [system, focus].filter(Boolean).join(' / ') || '未設定'
}

function scoutItems(scout: NonNullable<NonNullable<typeof projected>['opponentScout']>) {
  return [
    ['狙うレシーバー', scout.weakReceivers],
    ['避ける選手', scout.avoidPlayer],
    ['ターゲット選手', scout.targetPlayer],
    ['相手セッター', scout.opponentSetterState === 'unknown' ? '' : (opponentSetterStateLabels[scout.opponentSetterState] ?? scout.opponentSetterState)],
    ['ブロックが低い場所', scout.weakBlockZone],
    ['強いアタッカー', scout.strongAttackerNote],
    ['苦手ローテ', scout.weakRotationNote],
    ['サーブ戦術', scout.serveTacticNote],
    ['メモ', scout.generalNote],
  ].filter(([, value]) => Boolean(value))
}
---
<Base title="作戦ボード共有">
  <div class="min-h-screen bg-slate-50 text-slate-900">
    <main class="mx-auto max-w-6xl p-4 pb-10 space-y-4">
      {error ? (
        <section class="mx-auto mt-8 max-w-md rounded-lg border bg-white p-5 shadow-sm">
          <div class="text-xs font-semibold text-blue-700">V-Log 作戦ボード</div>
          <h1 class="mt-1 text-lg font-bold">共有ページを表示できません</h1>
          <p class="mt-2 text-sm leading-6 text-slate-600">{error}</p>
          {link?.passwordProtected && (
            <form class="mt-4 flex gap-2">
              <input name="password" type="password" class="field-input" placeholder="パスワード" />
              <button class="btn-primary shrink-0">表示</button>
            </form>
          )}
        </section>
      ) : projected && plan && team && (
        <>
          <header class="rounded-lg border bg-white p-4 shadow-sm">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <div class="text-xs font-semibold text-blue-700">{team.name}</div>
                <h1 class="mt-1 text-2xl font-bold leading-tight">{projected.name}</h1>
                <p class="mt-2 text-sm text-slate-600">
                  {projected.opponentName ? `対戦相手: ${projected.opponentName}` : '対戦相手未設定'}
                  {projected.setNumber ? ` / 第${projected.setNumber}セット` : ''}
                </p>
              </div>
              <span class="rounded-full bg-slate-900 px-3 py-1 text-xs font-semibold text-white">{scopeLabel(link.viewScope)}</span>
            </div>
            <dl class="mt-4 grid gap-2 text-xs sm:grid-cols-4">
              <div class="rounded-md bg-slate-50 p-2">
                <dt class="font-semibold text-slate-500">開始ローテ</dt>
                <dd class="mt-0.5 font-bold">{projected.startingRotationKey ?? '未設定'}</dd>
              </div>
              <div class="rounded-md bg-slate-50 p-2">
                <dt class="font-semibold text-slate-500">開始サーブ</dt>
                <dd class="mt-0.5 font-bold">{servingTeamLabel(projected.initialServingTeam)}</dd>
              </div>
              <div class="rounded-md bg-slate-50 p-2">
                <dt class="font-semibold text-slate-500">システム</dt>
                <dd class="mt-0.5 font-bold">{projected.systemType}</dd>
              </div>
              <div class="rounded-md bg-slate-50 p-2">
                <dt class="font-semibold text-slate-500">共有範囲</dt>
                <dd class="mt-0.5 font-bold">{scopeLabel(link.viewScope)}</dd>
              </div>
            </dl>
          </header>

          {link.viewScope === 'summary' && (
            <section class="rounded-lg border bg-white p-4 shadow-sm">
              <h2 class="text-sm font-bold">共有用サマリー</h2>
              <pre class="mt-3 whitespace-pre-wrap rounded-md bg-slate-50 p-3 text-sm leading-6 text-slate-700">{shareSummaryText}</pre>
            </section>
          )}

          <section class="grid gap-3 lg:grid-cols-2">
            {projected.rotations.map((rotation) => (
              <article class="break-inside-avoid rounded-lg border bg-white p-4 shadow-sm">
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <h2 class="text-lg font-bold">{rotation.key}</h2>
                    <p class="mt-0.5 text-xs text-slate-500">注目局面: {focusLabel(rotation.primaryFocusPhase)}</p>
                  </div>
                  <span class="rounded-full bg-blue-50 px-2 py-1 text-[11px] font-semibold text-blue-700">
                    S: {rotation.setterId ? shortPlayerLabel(rotation.setterId) : '未設定'}
                  </span>
                </div>

                {link.viewScope !== 'summary' && (
                  <div class="mt-3 overflow-hidden rounded-lg border bg-slate-50">
                    {layoutSlots.map((row) => (
                      <div class="grid grid-cols-3">
                        {row.map((slot) => {
                          const playerId = rotation.courtPlayerIds[slot]
                          const isSetter = rotation.setterId === playerId
                          const isBackRow = [0, 1, 2].includes(slot)
                          return (
                            <div class={`min-h-20 border border-slate-200 p-2 text-center ${isSetter ? 'bg-blue-50' : 'bg-white'}`}>
                              <div class="text-[11px] font-semibold text-slate-400">{slotLabels[slot]} / {isBackRow ? '後衛' : '前衛'}</div>
                              <div class="mt-1 text-sm font-bold leading-tight text-slate-900">{shortPlayerLabel(playerId)}</div>
                              {isSetter && <div class="mt-1 text-[11px] font-bold text-blue-700">セッター</div>}
                            </div>
                          )
                        })}
                      </div>
                    ))}
                  </div>
                )}

                {rotation.liberoReplacement && link.viewScope !== 'summary' && (
                  <div class="mt-3 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-800">
                    リベロIN: {playerLabel(rotation.liberoReplacement.liberoId)} → {playerLabel(rotation.liberoReplacement.replacedPlayerId)}
                  </div>
                )}

                <div class="mt-3 grid gap-2 sm:grid-cols-2">
                  <div class="rounded-md border-l-4 border-blue-500 bg-blue-50 p-3">
                    <div class="text-[11px] font-bold text-blue-700">重要ポイント</div>
                    <div class="mt-1 text-sm leading-6">{rotation.keyPoint || '未設定'}</div>
                  </div>
                  <div class="rounded-md border-l-4 border-orange-500 bg-orange-50 p-3">
                    <div class="text-[11px] font-bold text-orange-700">避けること</div>
                    <div class="mt-1 text-sm leading-6">{rotation.avoidNote || '未設定'}</div>
                  </div>
                </div>

                <div class="mt-3 grid gap-2 text-xs sm:grid-cols-3">
                  <div class="rounded-md bg-slate-100 p-2">
                    <div class="font-bold text-slate-600">Aパス1st</div>
                    <div class="mt-1">{rotation.receiveFirstOptions.good}</div>
                  </div>
                  <div class="rounded-md bg-slate-100 p-2">
                    <div class="font-bold text-slate-600">Bパス1st</div>
                    <div class="mt-1">{rotation.receiveFirstOptions.medium}</div>
                  </div>
                  <div class="rounded-md bg-slate-100 p-2">
                    <div class="font-bold text-slate-600">Cパス1st</div>
                    <div class="mt-1">{rotation.receiveFirstOptions.bad}</div>
                  </div>
                </div>

                {link.viewScope !== 'summary' && (
                  <div class="mt-3 grid gap-2 text-xs sm:grid-cols-2">
                    <div class="rounded-md border p-2">
                      <div class="font-bold text-slate-600">サーブ狙い</div>
                      <div class="mt-1">{serveTargetText(rotation)}</div>
                    </div>
                    <div class="rounded-md border p-2">
                      <div class="font-bold text-slate-600">ブロック方針</div>
                      <div class="mt-1">{blockPlanText(rotation)}</div>
                    </div>
                  </div>
                )}

                {link.viewScope === 'full' && rotation.notes && (
                  <div class="mt-3 rounded-md border bg-slate-50 p-2 text-xs leading-5 text-slate-700">
                    <span class="font-bold">メモ:</span> {rotation.notes}
                  </div>
                )}
              </article>
            ))}
          </section>

          {projected.opponentScout && (
            <section class="rounded-lg border bg-white p-4 shadow-sm">
              <h2 class="text-sm font-bold">相手分析メモ</h2>
              <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
                {scoutItems(projected.opponentScout).map(([label, value]) => (
                  <div class="rounded-md bg-slate-50 p-3">
                    <dt class="text-xs font-bold text-slate-500">{label}</dt>
                    <dd class="mt-1 leading-6 text-slate-800">{value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

          {projected.warnings.length > 0 && (
            <section class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
              <div class="font-semibold">注意</div>
              <ul class="mt-1 list-disc pl-5">
                {projected.warnings.map((warning) => <li>{warning.message}</li>)}
              </ul>
            </section>
          )}
        </>
      )}
    </main>
  </div>
</Base>
