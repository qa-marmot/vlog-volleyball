---
import Base from '../../layouts/Base.astro'

const guideSections = [
  {
    title: '1. 作成前に準備する',
    body: 'チームに6人以上の選手を登録してから作戦ボードを作成します。背番号とポジションを入れておくと、共有・印刷・選手表示で確認しやすくなります。',
    points: ['チームページで選手を登録', 'リベロはリベロ設定またはポジションLで登録', 'セットごとにスタメンが違う場合は別プランを作成'],
  },
  {
    title: '2. プランを作成する',
    body: '作戦一覧からプラン名、対戦相手、セット番号、基準ローテの6人を選んで作成します。R1は基準ローテで、サーブ権とは別に扱います。',
    points: ['1プランは1セット分', 'R1の6人を基準にR2からR6を自動生成', '開始ローテと開始サーブは試合開始条件の目安として設定'],
  },
  {
    title: '3. ローテ別に編集する',
    body: '各ローテで、重要ポイント、避けること、A/B/Cパス別の攻撃、サーブ狙い、ブロック方針、リベロ交代を入力します。',
    points: ['重要ポイントは選手が一番見る内容', '避けることはミスを減らす約束事', 'Aパス、Bパス、Cパスで最初に使う攻撃を分ける'],
  },
  {
    title: '4. 確定して共有する',
    body: '下書きのままでも編集できますが、共有リンクは確定済みプランから作成します。共有範囲は用途に合わせて選びます。',
    points: ['全体共有はコーチ・スタッフ向け', '選手向けは必要な情報に絞った表示', '要約はLINEやSlackに貼る短文向け', 'パスワード、期限、無効化で共有範囲を管理'],
  },
  {
    title: '5. 印刷・選手表示を使う',
    body: '印刷表示は紙やPDFで確認する用途、選手表示はスマートフォンで短く見る用途です。privateNotesや変更履歴は共有・印刷・選手表示には出ません。',
    points: ['コーチ用、選手用、カードの印刷モードを選択', '選手表示は各ローテの配置と要点を優先', '共有リンクは最新の確定内容を表示'],
  },
  {
    title: '6. 試合と紐づけて振り返る',
    body: '試合記録時にセット単位で作戦プランを紐づけると、その時点の作戦スナップショットが保存されます。後からプランを編集しても、過去試合の振り返りは当時の内容を参照します。',
    points: ['セットごとに作戦を選択', '試合結果画面でローテ別に振り返りを記録', '過去試合はスナップショットを参照'],
  },
]

const shareTypes = [
  ['全体共有', 'コーチ、スタッフ、分析担当が見る詳細版。相手分析は設定した場合だけ表示されます。'],
  ['選手向け', 'ローテ、配置、重要ポイント、避けること、A/B/Cパスを中心にした簡易版です。'],
  ['印刷用', '紙やPDFで配るための表示です。共有リンクからも開けます。'],
  ['要約', 'LINEやSlackで送る短い共有文です。URLと各ローテの要点をまとめます。'],
]

const systemTypes = [
  ['5-1', 'セッター1人で全ローテを組む形です。セッターが前衛でも後衛でも同じ選手がトスを上げます。'],
  ['6-2', 'セッターを2人置き、後衛のセッターがトスを上げる運用です。前衛側のセッターは攻撃参加しやすくなります。'],
  ['4-2', 'セッター2人を前衛・後衛の組み合わせで使う基本形です。チームの約束に合わせて使います。'],
  ['その他', 'チーム独自の呼び方や変則運用の場合に使います。'],
]

const rotationExplanations = [
  ['R1', '基準ローテです。作戦ボードで最初に選んだ6人の並びをそのまま表示します。試合開始時に必ずR1から始まるという意味ではありません。'],
  ['R2', 'R1から時計回りに1つ進んだ配置です。サイドアウト後など、次のローテに進んだ時の攻撃・守備約束を確認します。'],
  ['R3', 'R1から2つ進んだ配置です。セッターやミドルの前後関係が変わるため、A/B/Cパスで使える攻撃を見直します。'],
  ['R4', 'R1から3つ進んだ配置です。前衛・後衛の組み合わせが大きく変わるため、サーブ狙いやブロック方針も確認します。'],
  ['R5', 'R1から4つ進んだ配置です。後衛攻撃、リベロ交代、セッター1本目対応などの注意点を書いておくと便利です。'],
  ['R6', 'R1から5つ進んだ配置です。次に進むとR1へ戻るため、試合中に一巡した時の確認にも使います。'],
]

const rotationMemoFields = [
  ['注目局面', 'そのローテで特に確認したい場面です。レシーブ時、自サーブ時、両方のどれを重視するかを決めます。'],
  ['重要ポイント', '選手に一番守ってほしい作戦です。例: AパスならMBを優先、S前衛なのでライト側を厚く使う、など。'],
  ['避けること', 'そのローテで起こしやすいミスや避けたい選択です。例: Cパスで無理にクイックを使わない、リベロにサーブを集めない、など。'],
  ['要約メモ', '共有や確認時に短く伝える補足です。細かい戦術名より、試合中に読める短い言葉にします。'],
  ['リベロ交代', '後衛に下がったMBなど、リベロと交代する選手を指定します。リベロはコート上の6人には含めません。'],
  ['A/B/Cパス攻撃', 'レシーブの返球品質ごとに、1番手から3番手までの攻撃候補を設定します。選手別攻撃パターンとして共有ページにも表示されます。'],
  ['サーブ狙い', '短め、深め、選手間、リベロ回避など、相手の崩し方を指定します。'],
  ['ブロック・守備', 'リード、コミット、クロス締め、ライン締めなど、そのローテの守備方針を残します。'],
]
---
<Base title="ローテーション作戦ボードの使い方">
  <div class="min-h-screen bg-slate-50">
    <header class="app-header sticky top-0 z-10 px-4 py-3">
      <div class="mx-auto flex max-w-4xl items-center justify-between">
        <a href="/help" class="text-sm font-semibold text-white">V-Log</a>
        <a href="/login" class="text-xs text-slate-400 transition-colors hover:text-slate-200">ログイン</a>
      </div>
    </header>

    <main class="mx-auto max-w-4xl p-4 pb-12">
      <section class="py-8">
        <div class="text-xs font-bold text-blue-700">ユーザーガイド</div>
        <h1 class="mt-2 text-3xl font-bold leading-tight text-slate-900">ローテーション作戦ボードの使い方</h1>
        <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600">
          1セット分のスタメン6人を基準に、R1からR6までのローテ別作戦を整理する機能です。
          試合前の共有、当日の確認、試合後の振り返りまで同じプランを使えます。
        </p>
        <div class="mt-5 flex flex-wrap gap-2 text-xs">
          <span class="rounded-full bg-blue-50 px-3 py-1 font-semibold text-blue-700">1プラン = 1セット</span>
          <span class="rounded-full bg-orange-50 px-3 py-1 font-semibold text-orange-700">R1は基準ローテ</span>
          <span class="rounded-full bg-slate-100 px-3 py-1 font-semibold text-slate-700">共有リンク対応</span>
        </div>
      </section>

      <section class="grid gap-3 md:grid-cols-3">
        <div class="rounded-lg border bg-white p-4">
          <h2 class="text-sm font-bold text-slate-900">作る</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">スタメン6人とセット情報を登録し、R1を基準に全ローテを作ります。</p>
        </div>
        <div class="rounded-lg border bg-white p-4">
          <h2 class="text-sm font-bold text-slate-900">伝える</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">重要ポイント、避けること、A/B/Cパスの攻撃を選手向けに整理します。</p>
        </div>
        <div class="rounded-lg border bg-white p-4">
          <h2 class="text-sm font-bold text-slate-900">振り返る</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">試合セットに紐づけ、結果画面で作戦の実行状況を確認します。</p>
        </div>
      </section>

      <section class="mt-6 space-y-3">
        {guideSections.map((section) => (
          <article class="rounded-lg border bg-white p-5">
            <h2 class="text-lg font-bold text-slate-900">{section.title}</h2>
            <p class="mt-2 text-sm leading-7 text-slate-600">{section.body}</p>
            <ul class="mt-3 grid gap-2 text-sm text-slate-700 sm:grid-cols-3">
              {section.points.map((point) => (
                <li class="rounded-md bg-slate-50 px-3 py-2">{point}</li>
              ))}
            </ul>
          </article>
        ))}
      </section>

      <section class="mt-6 rounded-lg border bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">R1〜R6の見方</h2>
        <p class="mt-2 text-sm leading-7 text-slate-600">
          Rはローテーションの略です。R1は作戦ボード上の基準配置で、R2からR6はそこから順番に回転した配置です。
          開始ローテをR3にした場合でも、R1は基準として残り、試合開始時の表示だけがR3になります。
        </p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {rotationExplanations.map(([title, body]) => (
            <div class="rounded-md bg-slate-50 p-3">
              <h3 class="text-sm font-bold text-slate-900">{title}</h3>
              <p class="mt-1 text-sm leading-6 text-slate-600">{body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-6 rounded-lg border bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">ローテ別メモで書くこと</h2>
        <p class="mt-2 text-sm leading-7 text-slate-600">
          ローテ別メモは、試合中に選手が短時間で確認するための作戦メモです。
          「何を狙うか」と「何を避けるか」を先に決め、攻撃・サーブ・守備の細部をあとから足すと整理しやすくなります。
        </p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {rotationMemoFields.map(([title, body]) => (
            <div class="rounded-md border p-3">
              <h3 class="text-sm font-bold text-slate-900">{title}</h3>
              <p class="mt-1 text-sm leading-6 text-slate-600">{body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-6 rounded-lg border bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">共有範囲の選び方</h2>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {shareTypes.map(([title, body]) => (
            <div class="rounded-md border p-3">
              <h3 class="text-sm font-bold text-slate-900">{title}</h3>
              <p class="mt-1 text-sm leading-6 text-slate-600">{body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-6 rounded-lg border bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">システム種別の意味</h2>
        <p class="mt-2 text-sm leading-7 text-slate-600">
          5-1や6-2は、セッターを何人使うか、前衛で何人が攻撃に入りやすいかを表す呼び方です。
          作戦ボードでは警告や表示の補助に使います。
        </p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {systemTypes.map(([title, body]) => (
            <div class="rounded-md bg-slate-50 p-3">
              <h3 class="text-sm font-bold text-slate-900">{title}</h3>
              <p class="mt-1 text-sm leading-6 text-slate-600">{body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-5">
        <h2 class="text-lg font-bold text-amber-900">よくあるミス</h2>
        <div class="mt-3 grid gap-3 text-sm leading-6 text-amber-900 sm:grid-cols-2">
          <p>R1は「最初にサーブするローテ」ではなく、6人配置の基準です。試合開始時のローテは別に設定します。</p>
          <p>共有リンクは確定済みプランだけ作成できます。入力途中は下書きで保存し、配布前に確定してください。</p>
          <p>リベロはコート上の6人には含めません。交代設定で、入るリベロと交代される選手を指定します。</p>
          <p>過去試合の振り返りは当時のスナップショットを使います。現在のプラン編集は過去試合には反映されません。</p>
        </div>
      </section>
    </main>
  </div>
</Base>
